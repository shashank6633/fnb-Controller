# Valet Parking — environment variables (NO secrets live here).
# WhatsApp credentials are entered by the owner in the app (Settings → Integrations → WhatsApp)
# and stored in the app database, never in this file. RFID reader tokens are generated in
# Valet Settings and shown once.

# Production builds set NODE_ENV=production automatically. Only in production does valet
# (a) run its background worker without the flag below, and (b) ever send a real WhatsApp
# message (and then only for outlets whose "Send REAL WhatsApp messages" box is ticked).
# NODE_ENV=production

# Run the valet background worker (escalations, due pickups, message delivery, closing
# rush, daily clean-up) outside production — e.g. on a staging/testing server. Leave
# unset on a developer laptop that uses a copy of the live database.
# ENABLE_SCHEDULER=1

# DEVELOPER ONLY. Lets a non-production process send REAL WhatsApp messages. Never set
# this on a laptop or staging server holding a copy of production data.
# VALET_ALLOW_DEV_SEND=1
